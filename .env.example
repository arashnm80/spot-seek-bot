# Copy this file to .env and fill in real values.
# .env is gitignored. Do not commit secrets.
# Loaded from this repo's .env (path relative to variables.py), not from cwd.
# Existing process environment wins (dotenv override=False), so /etc/environment
# still takes precedence when both define the same key.

# Telegram bot
SPOT_SEEK_BOT_API=
MUSIC_DATABASE_ID=
LOG_CHANNEL_ID=

# Warp SOCKS JSON object. May also be provided system-wide; leave /etc/environment
# in place if other projects use WARP_PROXIES.
WARP_PROXIES={"http": "socks5h://user:pass@localhost:40001", "https": "socks5h://user:pass@localhost:40001"}

# JSON list of [spotify_client_id, spotify_client_secret] pairs
SPOTIFY_APPS_LIST=[["client_id", "client_secret"]]

# JSON list of SOCKS URLs: "socks5://user:pass@host:port"
SOCKS_PROXIES=["socks5://user:pass@host:port"]

# S3 (unused; bucket deleted)
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_NAME=

# SFTP (backup)
SFTP_HOST=
SFTP_PORT=23
SFTP_USERNAME=
SFTP_PASSWORD=

# Private Telegram archive channels (JSON object) and current inbox
CHANNEL_IDS={"sp1": 0, "sp2": 0}
SP11_CHANNEL_ID=

# Telegram webhook
WEBHOOK_SECRET_TOKEN=

# Telethon backup (shared with other Storage projects via /etc/environment)
DEVELOPER_TELEGRAM_APP_API_ID=
DEVELOPER_TELEGRAM_APP_API_HASH=
DEVELOPER_TELEGRAM_PHONE_NUMBER=
